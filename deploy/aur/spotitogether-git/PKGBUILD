# Maintainer: Opiderme <98979178+Opiderme@users.noreply.github.com>
pkgname=spotitogether-git
_pkgname=spotitogether
pkgver=r0
pkgrel=1
pkgdesc="Écoute Spotify synchronisée entre amis, dans le terminal (TUI)"
arch=('x86_64' 'aarch64')
url="https://github.com/Opiderme/Spotitogether-tui"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libpulse')
makedepends=('cargo' 'git')
optdepends=('caelestia-shell: couleurs du thème Caelestia'
            'spotifyd: lecteur Spotify sans interface graphique')
provides=("$_pkgname")
conflicts=("$_pkgname" "$_pkgname-bin")
# makepkg's LTO turns the bundled SQLite (rusqlite) into GCC bitcode that the
# Rust linker cannot read.
options=('!lto')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p spotitogether
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/spotitogether "$pkgdir/usr/bin/spotitogether"
  install -Dm644 deploy/spotitogether.service "$pkgdir/usr/lib/systemd/user/spotitogether.service"
  install -Dm644 deploy/spotitogether.desktop "$pkgdir/usr/share/applications/spotitogether.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm644 deploy/README.md "$pkgdir/usr/share/doc/$_pkgname/deploy.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
